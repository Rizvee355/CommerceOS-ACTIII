# Required values: disabled | mock | amd-token-factory. The public production release uses disabled.
INFERENCE_PROVIDER=disabled

# Server-only secret. Never expose with a NEXT_PUBLIC_ prefix or commit a value.
AMD_TOKEN_FACTORY_API_KEY=

# Authenticated ACT III Token Factory model used by the controlled local proof.
AMD_TOKEN_FACTORY_MODEL=DeepSeek-V4-Flash
