{
  "$id": "https://commerceos.dev/contracts/v1/human-review-metadata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decidedBy": {
      "const": "deterministic_policy",
      "type": "string"
    },
    "policyVersion": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "reasonCodes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "required": {
      "type": "boolean"
    }
  },
  "required": [
    "required",
    "reasonCodes",
    "decidedBy",
    "policyVersion"
  ],
  "title": "HumanReviewMetadata",
  "type": "object",
  "x-commerceos-runtime-validation": true
}
