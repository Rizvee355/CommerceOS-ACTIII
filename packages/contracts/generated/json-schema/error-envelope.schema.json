{
  "$id": "https://commerceos.dev/contracts/v1/error-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "authorization",
            "internal",
            "provider",
            "rate_limit",
            "timeout",
            "validation"
          ],
          "type": "string"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "fieldErrors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "format": "starts_with",
                "maxLength": 512,
                "pattern": "^\\/.*",
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "requestId": {
      "description": "Server-generated UUID",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp assigned by the server",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "traceId": {
      "description": "Server-generated UUID",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "timestamp",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object",
  "x-commerceos-runtime-validation": true
}
