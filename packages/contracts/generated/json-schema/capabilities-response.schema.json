{
  "$id": "https://commerceos.dev/contracts/v1/capabilities-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 280,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "enum": [
              "promiseguard",
              "marginleak",
              "rescuecart"
            ],
            "type": "string"
          },
          "label": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "routes": {
            "items": {
              "format": "starts_with",
              "pattern": "^\\/.*",
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "state": {
            "enum": [
              "planned",
              "stub",
              "active",
              "disabled"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "state",
          "routes"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "requestId": {
      "description": "Server-generated UUID",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp assigned by the server",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "traceId": {
      "description": "Server-generated UUID",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "timestamp",
    "capabilities"
  ],
  "title": "CapabilitiesResponse",
  "type": "object",
  "x-commerceos-runtime-validation": true
}
